<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>تسجيل نسب عرض العربي</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet"/>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>
<style>
:root{
  --p:#0ea5e9;--pd:#0284c7;--pl:#38bdf8;
  --ac:#06b6d4;--ac2:#67e8f9;
  --bg:#0a1628;
  --glass:rgba(14,165,233,.08);--gb:rgba(14,165,233,.25);--gs:rgba(14,165,233,.15);
  --tx:#e0f2fe;--tm:#7dd3fc;
  --glow:0 0 30px rgba(14,165,233,.3);
  --r:16px;--rs:10px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Cairo','Tajawal',sans-serif;background:var(--bg);color:var(--tx);min-height:100vh;overflow-x:hidden;position:relative}
.bg-canvas{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.bg-canvas::before{content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 80% 60% at 20% 20%,rgba(6,182,212,.15) 0%,transparent 60%),
             radial-gradient(ellipse 60% 80% at 80% 80%,rgba(14,165,233,.12) 0%,transparent 60%),
             linear-gradient(160deg,#0a1628 0%,#0c1e38 50%,#081422 100%)}
.bg-canvas::after{content:'';position:absolute;inset:0;
  background-image:linear-gradient(rgba(14,165,233,.04) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(14,165,233,.04) 1px,transparent 1px);
  background-size:60px 60px}
.floating-icons{position:absolute;inset:0}
.icon-item{position:absolute;opacity:0;filter:blur(.5px) drop-shadow(0 0 10px var(--p));animation:floatIcon linear infinite;will-change:transform,opacity}
@keyframes floatIcon{0%{transform:translateY(110vh) rotate(0deg) scale(.7);opacity:0}5%{opacity:.18}90%{opacity:.12}100%{transform:translateY(-15vh) rotate(25deg) scale(1.1);opacity:0}}
.page-wrapper{position:relative;z-index:1;min-height:100vh;display:flex;flex-direction:column;align-items:center;padding:40px 20px 100px}
.header{text-align:center;margin-bottom:40px;animation:fadeDown .9s ease both}
.header .logo-icon{font-size:48px;display:block;margin-bottom:10px;filter:drop-shadow(0 0 16px var(--p));animation:pulseGlow 3s ease-in-out infinite}
@keyframes pulseGlow{0%,100%{filter:drop-shadow(0 0 16px var(--p))}50%{filter:drop-shadow(0 0 28px var(--ac2))}}
.header h1{font-size:clamp(22px,5vw,36px);font-weight:900;background:linear-gradient(135deg,var(--ac2),var(--p),var(--ac));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1.2}
.header p{margin-top:8px;color:var(--tm);font-size:14px}
.fb-bar{display:inline-flex;align-items:center;gap:7px;margin-top:10px;padding:5px 14px;border-radius:20px;border:1px solid rgba(14,165,233,.2);font-size:12px;font-weight:700;background:rgba(14,165,233,.07)}
.fb-dot{width:8px;height:8px;border-radius:50%;background:#6b7280;transition:background .4s;flex-shrink:0}
.fb-dot.ok{background:#10b981;box-shadow:0 0 6px #10b981;animation:fbp 2s infinite}
.fb-dot.err{background:#ef4444}
@keyframes fbp{0%,100%{opacity:1}50%{opacity:.3}}
.dashboard-link{display:inline-flex;align-items:center;gap:8px;padding:8px 20px;background:rgba(14,165,233,.1);border:1px solid rgba(14,165,233,.3);border-radius:50px;color:var(--pl);font-family:'Cairo',sans-serif;font-size:13px;font-weight:700;text-decoration:none;margin-top:10px;transition:background .2s,transform .2s}
.dashboard-link:hover{background:rgba(14,165,233,.2);transform:translateY(-2px)}
.cta-btn{display:inline-flex;align-items:center;gap:12px;padding:18px 48px;font-family:'Cairo',sans-serif;font-size:clamp(18px,3vw,24px);font-weight:700;color:#fff;background:linear-gradient(135deg,var(--pd),var(--ac));border:none;border-radius:50px;cursor:pointer;position:relative;overflow:hidden;box-shadow:0 8px 32px rgba(14,165,233,.4);transition:transform .25s,box-shadow .25s;animation:fadeUp 1s .3s ease both}
.cta-btn::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,.15),transparent);opacity:0;transition:opacity .25s}
.cta-btn:hover{transform:translateY(-3px) scale(1.03);box-shadow:0 16px 48px rgba(14,165,233,.55)}
.cta-btn:hover::before{opacity:1}
.cta-btn:active{transform:scale(.98)}
.main-panel{width:100%;max-width:1050px;margin-top:32px;background:var(--glass);border:1px solid var(--gb);border-radius:var(--r);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);overflow:hidden;box-shadow:var(--glow),0 32px 64px rgba(0,0,0,.4);max-height:0;opacity:0;transform:translateY(20px);transition:max-height .7s cubic-bezier(.4,0,.2,1),opacity .5s,transform .5s}
.main-panel.open{max-height:6000px;opacity:1;transform:translateY(0)}
.panel-inner{padding:clamp(20px,4vw,36px)}
.section-title{display:flex;align-items:center;gap:10px;font-size:18px;font-weight:700;color:var(--ac2);margin-bottom:20px;padding-bottom:12px;border-bottom:1px solid var(--gb)}
.form-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:18px;margin-bottom:28px}
@media(max-width:700px){.form-grid{grid-template-columns:1fr 1fr}}
@media(max-width:460px){.form-grid{grid-template-columns:1fr}}
.field-group{display:flex;flex-direction:column;gap:7px}
.field-label{font-size:13px;font-weight:600;color:var(--tm)}
.field-label .req{color:var(--pl);margin-right:3px}
.field-input,.field-select{width:100%;padding:12px 16px;background:rgba(14,165,233,.07);border:1px solid var(--gb);border-radius:var(--rs);color:var(--tx);font-family:'Cairo',sans-serif;font-size:14px;outline:none;transition:border-color .2s,background .2s,box-shadow .2s;-webkit-appearance:none}
.field-input:focus,.field-select:focus{border-color:var(--p);background:rgba(14,165,233,.13);box-shadow:0 0 0 3px rgba(14,165,233,.15)}
.field-select option{background:#0f2040;color:var(--tx)}
.field-input::placeholder{color:rgba(125,211,252,.4)}
.field-input::-webkit-outer-spin-button,.field-input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.field-input[type=number]{-moz-appearance:textfield}

/* جدول الأقسام */
.sections-table-wrap{overflow-x:auto;margin-bottom:20px;border:1px solid var(--gb);border-radius:var(--rs)}
.sections-table{width:100%;border-collapse:collapse;min-width:750px;font-size:13px}
.sections-table th{background:rgba(14,165,233,.15);color:var(--ac2);font-weight:700;padding:12px 10px;text-align:center;border-bottom:1px solid var(--gb);white-space:nowrap;font-size:12px}
.sections-table th:first-child{text-align:right;min-width:130px}
.sections-table td{padding:10px;border-bottom:1px solid rgba(14,165,233,.08);text-align:center;vertical-align:middle}
.sections-table td:first-child{text-align:right;font-weight:700;color:var(--pl)}
.sections-table tr:last-child td{border-bottom:none}
.sections-table tr:hover td{background:rgba(14,165,233,.04)}
.sections-table .num-input{width:90px;padding:8px;background:rgba(14,165,233,.07);border:1px solid var(--gb);border-radius:8px;color:var(--tx);font-family:'Cairo',sans-serif;font-size:13px;text-align:center;outline:none;transition:border-color .2s,background .2s}
.sections-table .num-input:focus{border-color:var(--p);background:rgba(14,165,233,.13)}
.sections-table .num-input::-webkit-outer-spin-button,.sections-table .num-input::-webkit-inner-spin-button{-webkit-appearance:none}
.sections-table .num-input[type=number]{-moz-appearance:textfield}
.pct-cell{font-weight:900;font-size:14px}
.pct-before{color:#f87171}
.pct-after{color:#34d399}
.diff-positive{color:#34d399;font-weight:700}
.diff-negative{color:#f87171;font-weight:700}
.diff-zero{color:var(--tm);font-weight:600}
.section-badge{display:inline-flex;align-items:center;gap:4px;font-size:12px;font-weight:700;padding:3px 10px;border-radius:20px}
.del-row-btn{background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.3);color:#fca5a5;border-radius:6px;padding:6px 10px;cursor:pointer;font-size:13px;transition:background .2s}
.del-row-btn:hover{background:rgba(239,68,68,.25)}

.add-section-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;background:transparent;border:1px dashed rgba(14,165,233,.5);border-radius:50px;color:var(--pl);font-family:'Cairo',sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:background .2s,border-color .2s;margin-bottom:20px}
.add-section-btn:hover{background:rgba(14,165,233,.1);border-color:var(--p)}

.buttons-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:8px}
@media(max-width:500px){.buttons-row{grid-template-columns:1fr}}
.calc-btn{width:100%;padding:15px;background:linear-gradient(135deg,var(--pd),var(--ac));border:none;border-radius:var(--rs);color:#fff;font-family:'Cairo',sans-serif;font-size:16px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;transition:opacity .2s,transform .2s;box-shadow:0 6px 24px rgba(14,165,233,.35)}
.calc-btn:hover{opacity:.92;transform:translateY(-2px)}
.send-btn{width:100%;padding:15px;background:linear-gradient(135deg,#065f46,#059669);border:none;border-radius:var(--rs);color:#fff;font-family:'Cairo',sans-serif;font-size:16px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;transition:opacity .2s,transform .2s;box-shadow:0 6px 24px rgba(16,185,129,.3)}
.send-btn:hover:not(:disabled){opacity:.92;transform:translateY(-2px)}
.send-btn:disabled{opacity:.5;cursor:not-allowed;transform:none}
.divider{height:1px;background:linear-gradient(90deg,transparent,var(--gb),transparent);margin:28px 0}

/* نتائج التحليل */
.results-section{animation:fadeUp .5s ease both}
.summary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:24px}
@media(max-width:600px){.summary-grid{grid-template-columns:1fr 1fr}}
.sum-card{background:var(--gs);border:1px solid var(--gb);border-radius:var(--rs);padding:16px 12px;text-align:center;position:relative;overflow:hidden}
.sum-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--p),var(--ac2))}
.sum-card.before-card::before{background:linear-gradient(90deg,#ef4444,#f87171)}
.sum-card.after-card::before{background:linear-gradient(90deg,#059669,#34d399)}
.sum-card.diff-card::before{background:linear-gradient(90deg,#7c3aed,#a78bfa)}
.sum-card .card-lbl{font-size:11px;color:var(--tm);font-weight:600;margin-bottom:6px}
.sum-card .card-val{font-size:clamp(22px,4vw,32px);font-weight:900;line-height:1}
.sum-card.before-card .card-val{color:#f87171}
.sum-card.after-card .card-val{color:#34d399}
.sum-card.diff-card .card-val{color:#a78bfa}

.result-table-wrap{overflow-x:auto;border:1px solid var(--gb);border-radius:var(--rs);margin-bottom:20px}
.result-table{width:100%;border-collapse:collapse;font-size:13px;min-width:650px}
.result-table th{background:rgba(14,165,233,.12);color:var(--tm);font-weight:700;padding:10px 12px;text-align:center;border-bottom:1px solid var(--gb);white-space:nowrap;font-size:12px}
.result-table th:first-child{text-align:right}
.result-table td{padding:10px 12px;border-bottom:1px solid rgba(14,165,233,.07);text-align:center}
.result-table td:first-child{text-align:right;font-weight:700;color:var(--pl)}
.result-table tr:last-child td{border-bottom:none}
.pbar-wrap{display:flex;align-items:center;gap:6px;justify-content:center}
.pbar-mini{flex:1;height:6px;background:rgba(14,165,233,.1);border-radius:10px;overflow:hidden;min-width:60px}
.pbar-mini-fill{height:100%;border-radius:10px;transition:width 1s cubic-bezier(.4,0,.2,1)}
.pbar-mini-fill.before{background:linear-gradient(90deg,#ef4444,#f87171)}
.pbar-mini-fill.after{background:linear-gradient(90deg,#059669,#34d399)}

.analysis-box{background:rgba(14,165,233,.05);border:1px solid var(--gb);border-radius:var(--rs);padding:18px;margin-top:16px}
.analysis-box h5{font-size:14px;font-weight:700;color:var(--ac2);margin-bottom:12px}
.analysis-row{display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid rgba(14,165,233,.06);font-size:13px}
.analysis-row:last-child{border-bottom:none}
.analysis-lbl{color:var(--tm)}
.analysis-val{font-weight:700;color:var(--tx)}

.toast{position:fixed;bottom:30px;left:50%;transform:translateX(-50%) translateY(120px);opacity:0;pointer-events:none;background:linear-gradient(135deg,#065f46,#059669);border:1px solid rgba(16,185,129,.4);border-radius:50px;padding:14px 28px;color:#fff;font-family:'Cairo',sans-serif;font-size:15px;font-weight:700;display:flex;align-items:center;gap:10px;box-shadow:0 8px 32px rgba(16,185,129,.4);transition:transform .45s cubic-bezier(.34,1.56,.64,1),opacity .35s;z-index:9999;white-space:nowrap}
.toast.error{background:linear-gradient(135deg,#7f1d1d,#ef4444);border-color:rgba(239,68,68,.4);box-shadow:0 8px 32px rgba(239,68,68,.4)}
.toast.show{transform:translateX(-50%) translateY(0);opacity:1;pointer-events:auto}
.spinner{display:inline-block;width:16px;height:16px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite;flex-shrink:0}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes fadeDown{from{opacity:0;transform:translateY(-24px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
::-webkit-scrollbar{width:6px;height:6px}::-webkit-scrollbar-track{background:var(--bg)}::-webkit-scrollbar-thumb{background:var(--pd);border-radius:10px}

.legend-row{display:flex;gap:20px;flex-wrap:wrap;margin-bottom:12px;padding:10px 14px;background:rgba(14,165,233,.04);border-radius:var(--rs);font-size:12px}
.leg-item{display:flex;align-items:center;gap:6px;font-weight:600}
.leg-dot{width:10px;height:10px;border-radius:2px;flex-shrink:0}

.header-actions{display:flex;flex-direction:column;align-items:center;gap:8px;margin-top:14px}
</style>
</head>
<body>
<div class="bg-canvas"><div class="floating-icons" id="floatingIcons"></div></div>

<div class="page-wrapper">
  <header class="header">
    <span class="logo-icon">📊</span>
    <h2>تسجيل نسب عرض العربي</h2>
    <p>نظام متابعة ومقارنة نسب عرض منتجات العربي قبل وبعد التحسين</p>
    <div class="header-actions">
      <div class="fb-bar"><div class="fb-dot" id="fbDot"></div><span id="fbTxt">جاري الاتصال بـ Firebase...</span></div>
    </div>
  </header>

  <button class="cta-btn" id="ctaBtn" onclick="togglePanel()">
    <span>📋</span> تسجيل نسب العرض قبل وبعد
  </button>

  <div class="main-panel" id="mainPanel">
    <div class="panel-inner">
      <div class="section-title"><span>🏢</span> البيانات الأساسية</div>
      <div class="form-grid">
        <div class="field-group">
          <label class="field-label"><span class="req">*</span> اسم الفرع</label>
          <input type="text" class="field-input" id="branchInput" placeholder="مثال: فرع القاهرة — مدينة نصر"/>
        </div>
        <div class="field-group">
          <label class="field-label"><span class="req">*</span> اسم المندوب</label>
          <input type="text" class="field-input" id="agentName" placeholder="أدخل اسم المندوب"/>
        </div>
        <div class="field-group">
          <label class="field-label">التاريخ</label>
          <input type="text" class="field-input" id="dateField" readonly style="color:var(--ac2);cursor:default"/>
        </div>
      </div>

      <div class="section-title"><span>📦</span> جدول الأقسام — قبل وبعد التحسين</div>

      <div class="legend-row">
        <div class="leg-item"><div class="leg-dot" style="background:#f87171"></div> قبل التحسين</div>
        <div class="leg-item"><div class="leg-dot" style="background:#34d399"></div> بعد التحسين</div>
        <div class="leg-item"><div class="leg-dot" style="background:#a78bfa"></div> فرق النسبة</div>
      </div>

      <div class="sections-table-wrap">
        <table class="sections-table">
          <thead>
            <tr>
              <th>القسم</th>
              <th>منتجات العربي<br><small style="font-weight:400;color:#f87171">قبل</small></th>
              <th>إجمالي المنتجات<br><small style="font-weight:400;color:#f87171">قبل</small></th>
              <th>منتجات العربي<br><small style="font-weight:400;color:#34d399">بعد</small></th>
              <th>إجمالي المنتجات<br><small style="font-weight:400;color:#34d399">بعد</small></th>
              <th>نسبة العرض<br><small style="font-weight:400;color:#f87171">قبل</small></th>
              <th>نسبة العرض<br><small style="font-weight:400;color:#34d399">بعد</small></th>
              <th>فرق النسبة</th>
              <th>حذف</th>
            </tr>
          </thead>
          <tbody id="sectionsBody">
          </tbody>
        </table>
      </div>

      <button class="add-section-btn" onclick="addSectionRow()">➕ إضافة قسم جديد</button>

      <div class="buttons-row">
        <button class="calc-btn" onclick="calculate(true)">🔢 احسب النسب الآن</button>
        <button class="send-btn" id="sendBtn" onclick="sendReport()">📤 إرسال التقرير إلى لوحة التحكم</button>
      </div>

      <div id="resultsSection" style="display:none">
        <div class="divider"></div>
        <div class="section-title"><span>📈</span> نتائج المقارنة والتحليل</div>
        <div class="results-section">
          <div class="summary-grid">
            <div class="sum-card before-card">
              <div class="card-lbl">📉 متوسط نسبة العرض قبل</div>
              <div class="card-val" id="resBefore">0%</div>
            </div>
            <div class="sum-card after-card">
              <div class="card-lbl">📈 متوسط نسبة العرض بعد</div>
              <div class="card-val" id="resAfter">0%</div>
            </div>
            <div class="sum-card diff-card">
              <div class="card-lbl">✨ مقدار التحسن</div>
              <div class="card-val" id="resDiff">0%</div>
            </div>
          </div>

          <div class="result-table-wrap">
            <table class="result-table" id="resultTable">
              <thead>
                <tr>
                  <th>القسم</th>
                  <th>نسبة قبل</th>
                  <th>شريط قبل</th>
                  <th>نسبة بعد</th>
                  <th>شريط بعد</th>
                  <th>الفرق</th>
                  <th>التقييم</th>
                </tr>
              </thead>
              <tbody id="resultBody"></tbody>
            </table>
          </div>

          <div class="analysis-box">
            <h5>🔍 تحليل الأداء</h5>
            <div class="analysis-row"><span class="analysis-lbl">أفضل قسم تحسن</span><span class="analysis-val" id="bestSection">—</span></div>
            <div class="analysis-row"><span class="analysis-lbl">أضعف قسم أداء</span><span class="analysis-val" id="weakSection">—</span></div>
            <div class="analysis-row"><span class="analysis-lbl">عدد الأقسام المحسّنة</span><span class="analysis-val" id="improvedCount">0</span></div>
            <div class="analysis-row"><span class="analysis-lbl">عدد الأقسام المتراجعة</span><span class="analysis-val" id="declinedCount">0</span></div>
            <div class="analysis-row"><span class="analysis-lbl">تقييم الأداء العام</span><span class="analysis-val" id="overallRating">—</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
// ══════════════════════════════════════════
// Firebase Config
// ══════════════════════════════════════════
const firebaseConfig = {
  apiKey:            "AIzaSyAmzZoKM_YGQAlxHdj6N-s4iUegBrJKNAk",
  authDomain:        "display-a3abe.firebaseapp.com",
  databaseURL:       "https://display-a3abe-default-rtdb.firebaseio.com",
  projectId:         "display-a3abe",
  storageBucket:     "display-a3abe.firebasestorage.app",
  messa
